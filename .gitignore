# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript

# xero tokens
.xero-tokens.json

# push notification subscriptions
subscriptions.json

*.tsbuildinfo
next-env.d.ts
src/data/prospecting-history.json

# shared project images
/data/project-images.json
/public/uploads/projects/*
!/public/uploads/projects/.gitkeep

data/snapshots/

# BD session log (machine-local)
data/bd-sessions.json

# persisted project colour assignments (machine-local)
data/project-colors.json

# uploaded headshots (machine-local, like other uploads)
public/headshots/*.png
