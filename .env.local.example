# Office status — shared practice Google Calendar (see src/app/api/office-status)
# Base64-encoded service-account JSON key with calendar.readonly scope.
# Generate: base64 -i service-account.json | pbcopy
GOOGLE_SERVICE_ACCOUNT_KEY=base64-encoded-service-account-json
# The shared practice calendar id (looks like xxxx@group.calendar.google.com)
PRACTICE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
